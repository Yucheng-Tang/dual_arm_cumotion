      - "right_fr3_link7"
    right_fr3_link5: 
      - "right_fr3_link6"
      - "right_fr3_link7"
      - "right_fr3_leftfinger"
      - "right_fr3_rightfinger"
      - "right_fr3_hand"
    right_fr3_link6: 
      - "right_fr3_link7"
      - "right_fr3_leftfinger"
      - "right_fr3_rightfinger"
      - "right_fr3_hand"
    right_fr3_link7: 
      - "right_fr3_leftfinger"
      - "right_fr3_rightfinger"
      - "right_fr3_hand"
    right_fr3_hand: 
      - "right_fr3_leftfinger"
      - "right_fr3_rightfinger"
      - "right_attached_object"
    right_fr3_leftfinger: 
      - "right_fr3_rightfinger"
      - "right_attached_object"
    right_fr3_rightfinger: 
