    left_fr3_rightfinger: 
      - "left_attached_object"
    right_mount_link: 
      - "right_base"
    right_base: 
      - "right_fr3_link0"
    right_fr3_link0: 
      - "right_fr3_link1"
      - "right_fr3_link2"
    right_fr3_link1: 
      - "right_fr3_link2"
      - "right_fr3_link3"
      - "right_fr3_link4"
    right_fr3_link2: 
      - "right_fr3_link3"
      - "right_fr3_link4"
    right_fr3_link3: 
      - "right_fr3_link4"
      - "right_fr3_link6"
    right_fr3_link4: 
