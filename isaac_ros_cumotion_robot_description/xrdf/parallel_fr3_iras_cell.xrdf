      - "left_fr3_link3"
      - "left_fr3_link4"
    left_fr3_link3: 
      - "left_fr3_link4"
      - "left_fr3_link6"
    left_fr3_link4: 
      - "left_fr3_link5"
      - "left_fr3_link6"
      - "left_fr3_link7"
    left_fr3_link5: 
      - "left_fr3_link6"
      - "left_fr3_link7"
      - "left_fr3_hand"
      - "left_fr3_leftfinger"
      - "left_fr3_rightfinger"
