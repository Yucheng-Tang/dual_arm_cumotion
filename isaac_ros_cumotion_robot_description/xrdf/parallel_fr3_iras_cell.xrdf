format: "xrdf"

format_version: 1.0

modifiers:
  - add_frame:
      frame_name: "left_attached_object"
      parent_frame_name: "left_fr3_hand"
      joint_name: "left_attach_joint"
      joint_type: FIXED
      fixed_transform:
        position: [0.0, 0.0, 0.0]
        orientation: {w: 1.0, xyz: [0.0, 0.0, 0.0]}
  - add_frame:
      frame_name: "right_attached_object"
      parent_frame_name: "right_fr3_hand"
      joint_name: "right_attach_joint"
      joint_type: FIXED
      fixed_transform:
        position: [0.0, 0.0, 0.0]
        orientation: {w: 1.0, xyz: [0.0, 0.0, 0.0]}

default_joint_positions: 
  left_fr3_joint1: 0.0
  left_fr3_joint2: -1.3
  left_fr3_joint3: 0.0
  left_fr3_joint4: -2.5
  left_fr3_joint5: 0.0
  left_fr3_joint6: 1.0
  left_fr3_joint7: 0.0
  left_fr3_finger_joint1: 0.04
  left_fr3_finger_joint2: 0.04
  right_fr3_joint1: 0.0
  right_fr3_joint2: -1.3
  right_fr3_joint3: 0.0
  right_fr3_joint4: -2.5
  right_fr3_joint5: 0.0
  right_fr3_joint6: 1.0
  right_fr3_joint7: 0.0
  right_fr3_finger_joint1: 0.04
  right_fr3_finger_joint2: 0.04

cspace: 
  joint_names: 
    - "left_fr3_joint1"
    - "left_fr3_joint2"
    - "left_fr3_joint3"
    - "left_fr3_joint4"
    - "left_fr3_joint5"
    - "left_fr3_joint6"
    - "left_fr3_joint7"
    - "right_fr3_joint1"
    - "right_fr3_joint2"
    - "right_fr3_joint3"
    - "right_fr3_joint4"
    - "right_fr3_joint5"
    - "right_fr3_joint6"
    - "right_fr3_joint7"
  acceleration_limits: [10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]
  jerk_limits: [10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000, 10000]

tool_frames: ["right_fr3_link8", "left_fr3_link8"]

collision: 
  geometry: "parallel_fr3_collision_spheres"
  buffer_distance:
    left_fr3_link0: 0.004
    left_fr3_link1: 0.004
    left_fr3_link2: 0.004
    left_fr3_link3: 0.004
    left_fr3_link4: 0.004
    left_fr3_link5: 0.004
    left_fr3_link6: 0.004
    left_fr3_link7: 0.004
    left_fr3_hand: 0.004
    left_fr3_leftfinger: 0.004
    left_fr3_rightfinger: 0.004
    right_fr3_link0: 0.004
    right_fr3_link1: 0.004
    right_fr3_link2: 0.004
    right_fr3_link3: 0.004
    right_fr3_link4: 0.004
    right_fr3_link5: 0.004
    right_fr3_link6: 0.004
    right_fr3_link7: 0.004
    right_fr3_hand: 0.004
    right_fr3_leftfinger: 0.004
    right_fr3_rightfinger: 0.004

self_collision: 
  geometry: "parallel_fr3_collision_spheres"
  ignore: 
    base: 
      - "work_cell_link"
    work_cell_link: 
      - "left_mount_link"
      - "right_mount_link"
    left_mount_link: 
      - "left_base"
      - "right_mount_link"
    left_base: 
      - "left_fr3_link0"
    left_fr3_link0: 
      - "left_fr3_link1"
      - "left_fr3_link2"
    left_fr3_link1: 
      - "left_fr3_link2"
      - "left_fr3_link3"
      - "left_fr3_link4"
